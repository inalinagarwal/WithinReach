<mujoco model="within_reach">
  <compiler angle="radian"/>
  <option timestep="0.0041666667" gravity="0 0 -9.81" integrator="implicitfast"/>
  <default>
    <joint damping="2"/>
    <geom friction="0.35 0.005 0.0001" solref="0.015 1"/>
  </default>
  <visual><global offwidth="640" offheight="480"/></visual>
  <worldbody>
    <light pos="0 -0.3 1.5" dir="0 0 -1"/>
    <camera name="overview" pos="0 -0.72 0.95" xyaxes="1 0 0 0 0.8 0.6"/>
    <geom name="table" type="box" pos="0 0 -0.025" size="0.6 0.4 0.025" rgba="0.85 0.82 0.75 1"/>
    <body name="arm_base" pos="-0.45 0 0.18">
      <geom type="cylinder" pos="0 0 -0.09" size="0.035 0.09" rgba="0.2 0.25 0.3 1" contype="0" conaffinity="0"/>
      <body name="link1">
        <joint name="shoulder" type="hinge" axis="0 0 1"/>
        <geom name="arm_link1_collision" type="capsule" fromto="0 0 0 0.4 0 0" size="0.015" mass="0.3" rgba="0.3 0.45 0.65 1" contype="1" conaffinity="1"/>
        <body name="link2" pos="0.4 0 0">
          <joint name="elbow" type="hinge" axis="0 0 1"/>
          <geom name="arm_link2_collision" type="capsule" fromto="0 0 0 0.4 0 0" size="0.012" mass="0.2" rgba="0.4 0.55 0.75 1" contype="1" conaffinity="1"/>
          <!-- Links stay above the cup; this slide extends a contact tool downward. -->
          <body name="pusher_body" pos="0.4 0 -0.15">
            <joint name="lift" type="slide" axis="0 0 1" limited="true" range="0 0.16" damping="4"/>
            <geom name="pusher" type="cylinder" size="0.012 0.022" mass="0.08" rgba="0.15 0.2 0.25 1" friction="0.6 0.005 0.0001"/>
            <geom name="pusher_shaft" type="capsule" fromto="0 0 0.022 0 0 0.15" size="0.004" mass="0.01" rgba="0.3 0.3 0.35 1"/>
            <site name="tip" size="0.005"/>
          </body>
        </body>
      </body>
    </body>
    <body name="cup" pos="0 0 0.004">
      <freejoint name="cup_free"/>
      <inertial pos="0 0 0.042" mass="0.12" diaginertia="0.00018 0.00018 0.00012"/>
      <geom name="cup_bottom" type="cylinder" size="0.035 0.003" rgba="0.1 0.65 0.7 1"/>
      <!-- Wall segments are inserted by simulator.py; the cup is hollow. -->
      <geom name="handle_lower" type="capsule" fromto="0.035 0 0.023 0.065 0 0.023" size="0.004" rgba="0.1 0.65 0.7 1"/>
      <geom name="handle_outer" type="capsule" fromto="0.065 0 0.023 0.065 0 0.070" size="0.004" rgba="0.1 0.65 0.7 1"/>
      <geom name="handle_upper" type="capsule" fromto="0.065 0 0.070 0.035 0 0.070" size="0.004" rgba="0.1 0.65 0.7 1"/>
    </body>
  </worldbody>
  <actuator>
    <position name="shoulder_motor" joint="shoulder" kp="100" kv="8"/>
    <position name="elbow_motor" joint="elbow" kp="100" kv="6"/>
    <position name="lift_motor" joint="lift" kp="150" kv="8"/>
  </actuator>
</mujoco>
